[MENU]
MENUITEM=GRY, Gry: SB16, pamiec XMS              (Games: SB16, XMS)
MENUITEM=GRYEMS, Gry: SB16, pamiec XMS + EMS     (Games: SB16, XMS + EMS)
MENUITEM=TEST, Test karty, nagrywanie, mikser    (Card test, recording, mixer)
MENUITEM=BEZ, Bez SBEMU: USBTONE, CPUTEST        (Without SBEMU)
MENUITEM=DIAG, Diagnostyka: SBEMU recznie        (Diagnostics: manual SBEMU)
MENUDEFAULT=GRY,5
MENUCOLOR=7,0

[COMMON]
DOS=HIGH,UMB
FILES=30
BUFFERS=20
LASTDRIVE=Z

[GRY]
DEVICE=C:\SBEMU\JEMMEX.EXE X2MAX=8192 NOEMS X=E000-EFFF

[GRYEMS]
DEVICE=C:\SBEMU\JEMMEX.EXE X2MAX=8192 FRAME=D000 X=E000-EFFF

[TEST]
DEVICE=C:\SBEMU\JEMMEX.EXE X2MAX=8192 NOEMS X=E000-EFFF

[BEZ]
DEVICE=C:\HIMEMX.EXE

[DIAG]
DEVICE=C:\SBEMU\JEMMEX.EXE X2MAX=8192 NOEMS X=E000-EFFF

[COMMON]
SHELL=C:\COMMAND.COM C:\ /E:1024 /P
